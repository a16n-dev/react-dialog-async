  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "homepage": "https://react-dialog-async.a16n.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexn400/react-dialog-async.git"
  },
  "license": "MIT",
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "test": "vitest",
    "check": "tsc --noEmit",
    "lint": "eslint . ",
    "prepack": "node -e \"require('node:fs').copyFileSync('../../README.md', 'README.md')\""
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  },
  "keywords": [
    "react",
    "react-dialog-async",
    "react-native",
    "dialog",
    "promise",
    "modal",

{
  "name": "react-dialog-async",
  "description": "Ergonomic & performant dialog hooks for React & React Native",
  "type": "module",
  "version": "3.3.0",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "react-native": "index.esm.js",
